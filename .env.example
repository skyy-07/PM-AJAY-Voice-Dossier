# GEMINI_API_KEY: Required for Gemini AI API calls (multilingual NLU & dialogue reasoning).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Primary & Relational Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/pmajay_livelihood"
POSTGRES_URL="postgresql://user:password@localhost:5432/pmajay_livelihood"
REDIS_URL="redis://localhost:6379"

# Vector Search Engine (Qdrant / Milvus)
QDRANT_URL="https://your-qdrant-cluster.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key"

# Telephony & PSTN Integration (Asterisk / FreeSWITCH)
ASTERISK_HOST="sip.telecom.gov.in"
ASTERISK_USERNAME="pmajay_ivr_gateway"
ASTERISK_PASSWORD="your-asterisk-sip-secret"

# WhatsApp Business Voice Note Gateway
WHATSAPP_API_URL="https://graph.facebook.com/v20.0/your-phone-number-id/messages"
WHATSAPP_TOKEN="your-whatsapp-business-access-token"

# National Skilling & PM-AJAY Central Ecosystem APIs
PM_AJAY_API_URL="https://pmajay.dosje.gov.in/api/v1"
SKILL_INDIA_API_URL="https://www.skillindiadigital.gov.in/api/v2"

# Bhashini & AI4Bharat Speech & Translation Services
BHASHINI_API_KEY="your-bhashini-api-key"
INDIC_TTS_URL="https://api.bhashini.gov.in/v1/indic-tts"
INDIC_ASR_URL="https://api.bhashini.gov.in/v1/indic-asr"

